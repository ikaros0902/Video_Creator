{
  "name": "04_swiss_kinetic_type",
  "version": "1.0.0",
  "description": "High-contrast Swiss typographic rhythm for key ROI and metric reveals",
  "palette": {
    "bg_primary": "#0A0A0C",
    "bg_surface": "#141418",
    "text_primary": "#FFFFFF",
    "text_muted": "#A1A1AA",
    "accent_primary": "#FF5A1F",
    "accent_positive": "#10B981",
    "rule_line": "#27272A"
  },
  "typography": {
    "display_font": "Inter, Helvetica Neue, Arial, sans-serif",
    "mono_font": "JetBrains Mono, monospace",
    "hero_number_px": 150,
    "h1_px": 68,
    "body_px": 30
  },
  "motion": {
    "gsap_default_ease": "power3.out",
    "reveal_offset_px": 24,
    "min_hold_s": 1.5
  },
  "safe_zone": {
    "margin_x_px": 120,
    "margin_y_px": 80,
    "subtitle_reserve_bottom_px": 160
  },
  "forbidden": [
    "gradient filled typography",
    "more than two accent colors per scene"
  ]
}
