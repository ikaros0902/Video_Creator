{
  "name": "02_isometric_anatomy",
  "version": "1.0.0",
  "description": "Four-tone isometric mechanical diagram theme inspired by wheresryan22/anatomy",
  "palette": {
    "bg_primary": "#0D1524",
    "bg_surface": "#162238",
    "text_primary": "#F1F5F9",
    "text_muted": "#94A3B8",
    "iso_top": "#8FB3E8",
    "iso_left": "#5F84BD",
    "iso_right": "#4D6FA5",
    "iso_cutaway": "#3FE08A",
    "accent_warning": "#F5B041"
  },
  "typography": {
    "display_font": "Inter, system-ui, sans-serif",
    "mono_font": "JetBrains Mono, monospace",
    "h1_px": 52,
    "body_px": 28,
    "label_px": 24
  },
  "motion": {
    "gsap_default_ease": "power1.inOut",
    "cutaway_duration_s": 0.6,
    "min_hold_s": 2.0
  },
  "safe_zone": {
    "margin_x_px": 120,
    "margin_y_px": 80,
    "subtitle_reserve_bottom_px": 160
  },
  "forbidden": [
    "eyeballed non-isometric slopes",
    "labels inside crowded mesh polygons"
  ]
}
