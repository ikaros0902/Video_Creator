{% extends 'base.html.j2' %}{% from 'macros.html.j2' import clip, inset %}
{% block body %}
{% set count = [d.steps|length, 1]|max %}{% set card_width = (safe_width - 30 * (count - 1)) / count %}
{% set inset_width = [720, safe_width]|min %}{% set inset_left = (1920 - inset_width) / 2 %}
{% call clip('head',1,D,'left:' ~ margin ~ 'px;top:80px;','h1') %}{{ d.heading }}{% endcall %}
{% for step in d.steps %}{% set i=loop.index0 %}
{% call clip('step' ~ i,2+i,D,'left:' ~ (margin+i*(card_width+30)) ~ 'px;top:200px;width:' ~ card_width ~ 'px;height:260px;','card hide') %}
<div class="num" style="font-size:56px;position:absolute;left:30px;top:18px">{{ i+1 }}</div>
<div class="t" style="font-size:42px;position:absolute;left:30px;right:20px;top:100px">{{ step.title }}</div>
<div class="l" style="font-size:27px;position:absolute;left:30px;top:162px;right:20px">{{ step.label }}</div>{% endcall %}{% endfor %}
{{ inset(d,images,D,'left:' ~ inset_left ~ 'px;top:500px;width:' ~ inset_width ~ 'px;height:330px;',7) }}
{% call clip('icap',8,D,'left:' ~ inset_left ~ 'px;top:845px;width:' ~ inset_width ~ 'px;','cap hide') %}{{ d.inset.get('caption','') }}{% endcall %}
{% endblock %}
{% block script %}
show("#head", 0.1);
{% for step in d.steps %}{% set i=loop.index0 %}{% set at=cue(step.get('at_word'),2.0+i*3) %}
show("#step{{ i }}", {{ at }});
tl.to("#step{{ i }}", {borderColor:{{ c.accent|tojson }},duration:0.3}, {{ at }});
{% if i %}tl.to("#step{{ i-1 }}", {borderColor:{{ c.border|tojson }},duration:0.3}, {{ at }});{% endif %}{% endfor %}
{% set at=cue(d.inset.get('at_word'),D*0.6) %}
show("#inset", {{ at }}, {scale:0.96,y:0}); show("#icap", {{ at+0.2 }});
{% endblock %}
